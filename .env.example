# Model credentials — pick ONE (precedence: API key > subscription token > mock):
#  • ANTHROPIC_API_KEY: real API-billed agent via agentd's model proxy.
#  • CLAUDE_CODE_OAUTH_TOKEN: Claude Code SUBSCRIPTION billing — run
#    `claude setup-token` on the host and paste the sk-ant-oat01-… token here,
#    leaving ANTHROPIC_API_KEY blank. Sessions then call api.anthropic.com
#    directly. Note: Anthropic's terms restrict subscription OAuth for headless
#    automation (docs/AGENTS_RESEARCH.md) — personal-use opt-in.
#  • Both blank: deterministic offline mock model.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# ── Offline mock-model script (test rigs only) ────────────────────────────────
# Read ONLY in mock mode (both credentials above blank). Unset, the mock serves
# one canned text turn and can never emit a tool_use — which is why no offline
# test could ever make the model call an MCP tool. Set, the mock serves scripted
# turns instead. A misconfigured script fails agentd's boot loudly.
#
# Selection is stateless. WHICH SCRIPT: the first rule whose `match` substring
# appears in the raw model request wins (`match:""` matches anything; the
# optional `absent` keeps a rule away from requests containing that substring).
# The natural `match` key is a worker name — it appears in every request's
# composed system prompt. WHICH TURN: the number of assistant messages in the
# request, so turn 0 is the model's first reply and turn 1 what it says once the
# tool result has come back. Running past the end of a script yields the ordinary
# canned text turn, never a repeated tool call.
#
#   AGENTKIT_MOCK_MODEL_SCRIPT={"rules":[{"match":"email-reviewer","turns":[
#     {"blocks":[{"type":"tool_use","name":"mcp__core__worker_prompt_write",
#       "input":{"worker":"email-answerer","system_prompt":"Be warm.",
#                "rationale":"answers read as curt"}}]},
#     {"blocks":[{"type":"text","text":"Rewrote the answerer's prompt."}]}]}]}
#
# `{"turns":[…]}` alone is shorthand for one catch-all rule. Long scripts are
# easier to mount as a file (path INSIDE the agentd container):
# AGENTKIT_MOCK_MODEL_SCRIPT=
# AGENTKIT_MOCK_MODEL_SCRIPT_FILE=

# HS256 secret agentd uses to VERIFY JWTs that apps mint (and that /dev/token signs).
# Leave blank for dev-open mode (no auth) — fine for a local demo only.
# REQUIRED (and worth changing) when a login mode below is enabled.
AGENTKIT_JWT_SECRET=dev-secret

# ── Login + projects (optional — leave unset for the zero-login demo) ──────────
# Google login: create an OAuth 2.0 Client ID (Web application) in the Google
# Cloud console with authorized JavaScript origin http://localhost:8080.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
#
# Hard-coded email → projects map (a project is a kebab-case namespace over
# sessions). Inline JSON, or AGENTKIT_PROJECT_MAP_FILE=/path/to/projects.json.
# A "*" in a user's list is a wildcard (dev): every project in the map, plus
# the ability to create new projects from the UI.
# AGENTKIT_PROJECT_MAP={"kaiyadavenport@gmail.com":["*"]}
#
# Fixed password login (TEST/DEV only — grants every project in the map).
# Used by e2e/run-stack-e2e.sh; handy for local dev without Google.
# AGENTKIT_TEST_LOGIN=test@example.com:orange-e2e

# Sandbox image the Runner launches per session. Override to your own app image.
BASE_IMAGE=agentkit-sandbox:dev

# Host port the browser opens.
WEB_PORT=8080

# Externally-reachable base URL of the web UI. Session permalinks
# (<base>/p/<project>/s/<session>) are minted from it and travel far from the
# browser — into memory search results, config-log entries, image/skill
# provenance and request_human_attention webhooks — so it must be a URL the
# recipient can actually open. Defaults to http://localhost:${WEB_PORT}; set it
# to your real hostname once the stack is not on localhost.
# AGENTKIT_PUBLIC_BASE_URL=https://orange.example.com

# ── Session port pool (how many sessions this host can run at once) ───────────
# Every live session leases one host port and holds it until the session is
# DELETED — nothing reaps them on a timer — so the size of this range IS the
# concurrent-session ceiling for the host. Unset → 30001-30100, exactly what
# agentd used before the variables existed: 100 sessions, and the 101st fails
# with "the host port pool is exhausted".
#
# Set BOTH or neither (one alone is a boot error, so an operator's number is
# never silently paired with a default). A non-numeric bound, start above end, a
# port outside 1024-65535, or a range wider than 10000 ports all stop agentd at
# boot rather than starting a pool that fails every session. The effective range
# is logged at boot: "[agentd] session port pool=30001-30100 (100 concurrent …)".
#
# Narrowing it is the supported way to exercise exhaustion: a pool of three hits
# the real error, at a real caller, in seconds.
# AGENTKIT_PORT_RANGE_START=40000
# AGENTKIT_PORT_RANGE_END=40002

# ── Session garbage collection (what gives those ports back) ──────────────────
# A session that has been idle this long is SNAPSHOTTED and its container
# released, which returns its host port to the pool above. This is reclamation,
# not deletion: the session row survives, and the next message restores the
# container from the snapshot and carries on — a returning user sees a slightly
# slower first reply and nothing else. Unset → 30m.
#
# Shorter reclaims capacity sooner and pays a restore more often; longer keeps
# chat instant for longer while holding a container for a conversation nobody is
# having. "off" disables it, which is what agentd did before this existed: then
# nothing reclaims anything on a timer and the port pool only ever drains.
# Values below 1m or above 720h are refused at boot (the sweep runs once a
# minute, and a bare number like "30" is a missing unit, not a duration).
# AGENTKIT_SESSION_IDLE_TIMEOUT=30m

# How often the snapshot TTL reaper sweeps the image catalogue for versions
# whose expiry has passed — the other half of the same lifecycle: the line above
# CREATES snapshots, this retires them (bytes deleted, catalogue record kept as
# a tombstone). Unset → 6h; "off" disables it. The expiry itself is per project
# (project_settings.snapshot_ttl_days, 30 by default, 0 = never), so this is
# only how often we look; a day-granular promise does not need a minutely
# sweep. Needs DATABASE_URL — the catalogue is Postgres-only.
# AGENTKIT_SNAPSHOT_REAP_INTERVAL=6h

# ── MCP credentials (optional — leave unset until a session needs an MCP tool) ──
# MCP config stored in the database only ever NAMES a variable — e.g. a worker's
# mcp_config holding {"env": {"GMAIL_API_KEY": "${GMAIL_API_KEY}"}}. The value
# lives here, in the operator's environment, and never in the database.
#
# AGENTKIT_MCP_ENV is the ALLOWLIST of variable names agentd forwards into every
# session container, where the sandbox resolves those ${VAR} references when it
# spawns the MCP server. Comma-separated, names only:
#
#   AGENTKIT_MCP_ENV=GMAIL_API_KEY,NOTION_AUTH
#
# It is an allowlist, never "forward everything": agentd's own environment holds
# things sessions must not see (AGENTKIT_JWT_SECRET, ANTHROPIC_API_KEY,
# DATABASE_URL, …). Naming one of those is refused at boot. A name that is unset
# in agentd's environment is logged as a warning and not forwarded — the MCP
# server referencing it then fails loudly at spawn rather than silently
# authenticating with an empty credential.
#
# Each variable you list must also REACH agentd: add it below AND to the agentd
# service's `environment:` block in docker-compose.yml (one line per variable).
# AGENTKIT_MCP_ENV=
# GMAIL_API_KEY=
# NOTION_AUTH=

# ── Memory: the semantic search leg (spec §7.5–§7.6) ──────────────────────────
# none (default) | mock. Unset, memory search is keyword + recency with the same
# result shape — a supported deployment, not a degraded one. `mock` is a
# deterministic offline embedder: it tracks WORD OVERLAP, not meaning, so it is
# for tests and demos, never a claim about retrieval quality. A typo here is a
# boot error rather than a silent fall back to none.
# AGENTKIT_EMBEDDING_BACKEND=mock

# ── Storage backends (default = local: filesystem blobs + blob-archive snapshots) ──
# Leave these unset for the offline local stack. Set them to run on Google Cloud.
#
# Blobs (artifact bytes + blob-archive snapshots) → Google Cloud Storage:
#   AGENTKIT_BLOB_BACKEND=gcs
#   GCS_BUCKET=webkit-servers-agent-orange
#   GCS_PREFIX=                       # optional key prefix within the bucket
#
# Session-snapshot images → Google Artifact Registry (instead of blob-archive):
#   AGENTKIT_REGISTRY_BACKEND=ociregistry
#   AGENTKIT_REGISTRY_AUTH=gcp        # gcp (ADC token) | basic
#   GCP_REGION=europe-west1
#   GCP_PROJECT=webkit-servers
#   GCP_AR_REPO=agent-orange          # → europe-west1-docker.pkg.dev/webkit-servers/agent-orange
#   # …or set OCI_REGISTRY=<full-url> directly; for basic auth set OCI_USERNAME/OCI_PASSWORD.
#
# GCP auth uses Application Default Credentials. For the containerised stack the
# agentd container needs ADC — mount a service-account key and point
# GOOGLE_APPLICATION_CREDENTIALS at it (see docker-compose.yml comments).
# GOOGLE_APPLICATION_CREDENTIALS=/gcp/key.json
