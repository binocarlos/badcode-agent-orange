#!/usr/bin/env bash
#
# ./stack — the local development stack for Agent Orange.
#
# Deliberately small. Everything here exists because running the stack by hand
# has two traps that bite before you see anything (README-stack.md), and because
# `docker compose logs -f` across five services is unreadable in one pane.
#
#   ./stack build          build the images
#   ./stack start          bring it up with a REAL model + tmux panes  (BILLABLE)
#   ./stack start mock     bring it up with the deterministic mock model (free)
#   ./stack start mock registry   sessions PULL their base image from Artifact
#                          Registry instead of building it into DinD — the same
#                          path production takes. Needs ./stack publish-base first.
#   ./stack publish-base [tag]    build + push session-base/session-core to
#                          Artifact Registry (default tag: dev; never moves :latest)
#   ./stack stop           tear it down and kill the tmux session
#   ./stack restart [svc]  restart one service (or all)
#   ./stack logs [svc...]  follow logs
#   ./stack psql [args]    psql shell into postgres
#   ./stack sql "SELECT …" run one statement
#   ./stack status         model mode, services, session/port usage
#   ./stack sessions       list live sessions
#   ./stack clean          delete every session (frees containers + host ports)
#   ./stack testdb [up|down]  throwaway Postgres for the live-PG Go suite
#   ./stack test-go [args]    go test with live Postgres wired up correctly
#
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

TMUX_SESSION="${TMUX_SESSION:-agent-orange}"
WEB_PORT="${WEB_PORT:-8080}"

# ── The compose invocation ───────────────────────────────────────────────────
# Naming `-f docker-compose.yml` explicitly is LOAD-BEARING, not tidiness: a
# plain `docker compose` also picks up docker-compose.override.yml, which is
# gitignored and local-only. The default local stack wants nothing from it.
#
# Registry mode is the exception — it needs the override's GCP credential mount,
# so it opts back in via use_override. (The override now mounts your *gcloud*
# ADC directory. It used to bind ./secrets/gcp-key.json, which never existed as
# a file, so Docker created it as a DIRECTORY and agentd died with "gcsblob: new
# client: dialing: read /gcp/key.json: is a directory".)
COMPOSE_FILES=(-f docker-compose.yml)
compose() { docker compose "${COMPOSE_FILES[@]}" "$@"; }
use_override() { COMPOSE_FILES=(-f docker-compose.yml -f docker-compose.override.yml); }

# ── Neutralising the .env traps ──────────────────────────────────────────────
# A real .env carries this project's GCP settings, which do not work locally.
# Shell environment beats .env in compose, so exporting these overrides them
# without editing a real credential file. See README-stack.md.
local_backends() {
  export GOOGLE_APPLICATION_CREDENTIALS=
  export AGENTKIT_BLOB_BACKEND=fs
  export AGENTKIT_REGISTRY_BACKEND=blobarchive
}

# Blank BOTH model credentials. Mock mode needs both — the subscription token
# alone is enough to make a session bill.
mock_model() {
  export ANTHROPIC_API_KEY=
  export CLAUDE_CODE_OAUTH_TOKEN=
}

# ── Registry mode: dev/prod parity for the session base image ────────────────
# The default local flow builds the harness INSIDE DinD (init-sandbox) and hands
# it to sessions. Production does something different: it PULLS a published
# image from Artifact Registry. That divergence hides registry, credential and
# image-reference bugs until deploy, and gives downstream client projects
# nothing to build FROM. Registry mode runs the production path locally.
#
# Blobs stay on the local filesystem on purpose: snapshots are large and this is
# the shared PROD bucket. Set AGENTKIT_BLOB_BACKEND=gcs yourself (ideally with a
# GCS_PREFIX of your own) if you specifically want to exercise the GCS path.
dotenv() {
  local val="${!1:-}"
  if [[ -z "$val" && -f .env ]]; then
    val=$(grep -E "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true)
  fi
  printf '%s' "$val"
}

# The Artifact Registry base, assembled the same way agentd's resolveOCIRegistryURL
# does it — OCI_REGISTRY wins, else GCP_REGION+GCP_PROJECT+GCP_AR_REPO.
ar_registry() {
  local explicit region project repo
  explicit=$(dotenv OCI_REGISTRY)
  if [[ -n "$explicit" ]]; then printf '%s' "$explicit"; return; fi
  region=$(dotenv GCP_REGION); project=$(dotenv GCP_PROJECT); repo=$(dotenv GCP_AR_REPO)
  if [[ -z "$region" || -z "$project" || -z "$repo" ]]; then
    echo "registry mode needs OCI_REGISTRY, or all of GCP_REGION+GCP_PROJECT+GCP_AR_REPO (shell or .env)" >&2
    exit 1
  fi
  printf '%s-docker.pkg.dev/%s/%s' "$region" "$project" "$repo"
}

registry_backends() {
  # ADC is how agentd authenticates. It resolves the credential itself and passes
  # it per-pull as the Docker API's X-Registry-Auth header, so DinD needs no
  # credentials of its own — that is what makes this cheap.
  if [[ ! -f "$HOME/.config/gcloud/application_default_credentials.json" ]]; then
    echo "No gcloud ADC found. Run:  gcloud auth application-default login" >&2
    exit 1
  fi
  export AGENTKIT_BLOB_BACKEND=fs
  export AGENTKIT_REGISTRY_BACKEND=ociregistry
  export AGENTKIT_REGISTRY_AUTH=gcp
  # `:dev` is a stable tag with drifting contents; without this a session reuses
  # whatever DinD cached and you test bytes you did not just publish.
  export AGENTKIT_REGISTRY_ALWAYS_PULL=true
  # Must be empty or the Google libraries look for a key file instead of the
  # mounted gcloud ADC. A real .env sets it to a path that does not exist here.
  export GOOGLE_APPLICATION_CREDENTIALS=
  export BASE_IMAGE="$(ar_registry)/session-core:${AO_IMAGE_TAG:-dev}"
  use_override
  echo "── registry mode: sessions PULL $BASE_IMAGE (production's path) ──"
}

# Build + push the two base images downstream projects build FROM.
publish_base() {
  local tag="${1:-dev}"
  local reg; reg="$(ar_registry)"
  echo "── publishing session-base + session-core to $reg at :$tag ──"
  # PUSH_LATEST=false: this is a shared registry, and moving :latest from a dev
  # machine moves it for everyone — the thing a :dev tag exists to avoid.
  REGISTRY="$reg" PUSH_LATEST=false ./deploy/publish-base.sh "$tag"
}

# Which image mode the running stack was started in. Persisted so restart/stop
# reconfigure agentd the same way `start` did rather than reverting to local.
MODE_FILE=".stack-image-mode"

apply_saved_mode() {
  if [[ "$(cat "$MODE_FILE" 2>/dev/null || echo local)" == "registry" ]]; then
    registry_backends
  else
    local_backends
  fi
}

have_key() {
  # Is a real model credential going to reach agentd? Consults the shell first,
  # then .env, because that is the order compose resolves them in.
  local k="${ANTHROPIC_API_KEY:-}" t="${CLAUDE_CODE_OAUTH_TOKEN:-}"
  if [[ -z "$k$t" && -f .env ]]; then
    k=$(grep -E '^ANTHROPIC_API_KEY=.' .env 2>/dev/null | head -1 | cut -d= -f2- || true)
    t=$(grep -E '^CLAUDE_CODE_OAUTH_TOKEN=.' .env 2>/dev/null | head -1 | cut -d= -f2- || true)
  fi
  [[ -n "$k$t" ]]
}

# ── Commands ─────────────────────────────────────────────────────────────────

build() {
  local_backends
  compose build "$@"
  echo
  echo ">> Built. The web image is a BUILT bundle of examples/web — UI edits are"
  echo ">> invisible until you rebuild it:  ./stack build web && ./stack restart web"
}

start() {
  # Two independent axes: which MODEL (real|mock) and where the session base
  # IMAGE comes from (local|registry). Order does not matter.
  local mode="real" images="local" arg
  for arg in "$@"; do
    case "$arg" in
      real|mock)     mode="$arg" ;;
      local|registry) images="$arg" ;;
      *) echo "usage: ./stack start [real|mock] [local|registry]" >&2; exit 1 ;;
    esac
  done

  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo "Session $TMUX_SESSION already exists. Attaching…"
    exec tmux -2 attach -t "$TMUX_SESSION"
  fi

  if [[ "$images" == "registry" ]]; then registry_backends; else local_backends; fi
  echo "$images" > "$MODE_FILE"

  case "$mode" in
    mock)
      mock_model
      echo "── mock model: deterministic, offline, free ──"
      ;;
    real)
      if ! have_key; then
        echo "No ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN found in the shell or .env." >&2
        echo "Either set one, or run:  ./stack start mock" >&2
        exit 1
      fi
      echo "── REAL MODEL — this stack will BILL (the subscription token wins over"
      echo "   the API key when both are set). Use './stack start mock' if you"
      echo "   only meant to click around. ──"
      ;;
  esac

  compose up -d

  echo "Creating tmux session $TMUX_SESSION…"
  local size w h
  size=$(stty size 2>/dev/null || echo "50 200")
  h=$(echo -n "$size" | awk '{print $1}'); w=$(echo -n "$size" | awk '{print $2}')
  tmux -2 new-session -d -s "$TMUX_SESSION" -x "${w:-200}" -y "$(( ${h:-50} - 1 ))"
  for _ in 1 2 3; do
    tmux split-window -v -t "$TMUX_SESSION"
    tmux select-layout -t "$TMUX_SESSION" even-vertical
  done

  tmux send-keys -t 0 './stack logs agentd' C-m
  tmux send-keys -t 1 './stack logs dind init-sandbox' C-m
  tmux send-keys -t 2 './stack logs web postgres' C-m
  # The status pane answers the question you actually have on attach: which
  # model am I talking to, and how many ports have I burned?
  tmux send-keys -t 3 'clear; ./stack status' C-m
  tmux resize-pane -t 3 -y 14 2>/dev/null || true
  tmux select-pane -t 3 2>/dev/null || true

  tmux -2 attach-session -t "$TMUX_SESSION"
}

stop() {
  apply_saved_mode
  compose down --remove-orphans
  tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true
  rm -f "$MODE_FILE"
  echo "Stopped."
}

restart() {
  local svc="${1:-all}"
  # Without this a restart in registry mode would silently recreate agentd with
  # the LOCAL backends — sessions would then look for an image nothing pulled.
  apply_saved_mode
  if [[ "$svc" == "all" ]]; then
    compose down && compose up -d
  else
    # stop+up rather than `restart`, so compose-file and env changes are picked up.
    compose stop "$svc" && compose up -d "$svc"
  fi
}

logs() {
  # Follow only on a terminal. The tmux panes want -f; a pipe or a `timeout`
  # wrapper wants the log to end, or the output never flushes.
  if [[ -t 1 ]]; then compose logs -f --tail=100 "$@"
  else compose logs --tail=100 "$@"; fi
}

psql() {
  local user="${POSTGRES_USER:-agentorange}" db="${POSTGRES_DB:-agentorange}"
  compose exec postgres psql --user "$user" --dbname "$db" "$@"
}

sql() {
  local user="${POSTGRES_USER:-agentorange}" db="${POSTGRES_DB:-agentorange}"
  compose exec -T postgres psql --user "$user" --dbname "$db" -c "$*"
}

status() {
  echo "── services ───────────────────────────────────────────────"
  compose ps --format 'table {{.Service}}\t{{.Status}}' 2>/dev/null || echo "(not running)"
  echo
  echo "── session base image ─────────────────────────────────────"
  if [[ "$(cat "$MODE_FILE" 2>/dev/null || echo local)" == "registry" ]]; then
    echo "registry mode — pulled from Artifact Registry (production's path)"
    compose logs agentd 2>/dev/null | grep -iE 'ociregistry|pull image' | tail -2 || true
  else
    echo "local mode — built into DinD by init-sandbox"
  fi
  compose logs init-sandbox 2>/dev/null | tail -1 || true
  echo
  echo "── model ──────────────────────────────────────────────────"
  # agentd states its choice at boot. That log line, not the env, is the truth:
  # it is what the process actually resolved. Subscription mode logs its own
  # line ('subscription mode …'), separate from the proxy's.
  compose logs agentd 2>/dev/null | grep -iE 'model proxy|subscription mode' | tail -3 || echo "(agentd not up)"
  echo
  echo "── sessions / host ports ──────────────────────────────────"
  # A session holds one container and one host port until deleted or reclaimed
  # for idleness; the pool is the ceiling on CONCURRENT sessions.
  compose logs agentd 2>/dev/null | grep -i 'port pool' | tail -1 || true
  local n
  n=$(sql "select count(*) from agent_sessions where deleted_at = 0;" 2>/dev/null | sed -n '3p' | tr -d ' ' || echo '?')
  echo "live sessions: ${n:-?}   ( ./stack sessions | ./stack clean )"
  echo
  echo "UI: http://localhost:${WEB_PORT}"
}

sessions() {
  sql "select id, coalesce(name,'-') as name, customer as project, status,
              to_timestamp(created_at/1000)::timestamp(0) as created
       from agent_sessions where deleted_at = 0 order by created_at desc limit 50;"
}

clean() {
  # Sessions are the scarce resource here: each holds a container and one of the
  # 100 host ports. This deletes through the API so containers are released,
  # rather than truncating the table and orphaning them.
  echo "Deleting all sessions via the API…"
  local base="http://localhost:${WEB_PORT}"
  local tok; tok=$(curl -fsS "$base/dev/token" 2>/dev/null | sed -n 's/.*"token":"\([^"]*\)".*/\1/p' || true)
  if [[ -z "$tok" ]]; then
    echo "Could not get a /dev/token (login mode on, or stack down)." >&2
    echo "Delete from the UI instead, or './stack stop' to release everything." >&2
    exit 1
  fi
  local ids
  ids=$(curl -fsS -H "Authorization: Bearer $tok" "$base/agent/sessions?user_email=*" \
        | grep -o '"id":"[^"]*"' | cut -d'"' -f4 || true)
  local count=0
  for id in $ids; do
    curl -fsS -X DELETE -H "Authorization: Bearer $tok" "$base/agent/sessions/$id" >/dev/null && count=$((count+1))
  done
  echo "Deleted $count session(s)."
}

# ── The throwaway Postgres for the live-PG test suite ────────────────────────
# ~500 Go tests only run against a real Postgres, and they are the ONLY proof of
# the jsonb selectors, the tsvector/pgvector hybrid search and every migration.
# Two traps this exists to remove:
#   1. Unset AGENTKIT_TEST_POSTGRES_URL and they SKIP — a green run proves nothing.
#   2. Set but UNREACHABLE and they FAIL — a red run that looks like a regression
#      and is not. (Every such failure takes 0.00s; that is the tell.)
# It must be a throwaway, never a shared database: an unmerged migration on a
# sibling branch has broken other people's runs from a shared one before.
TESTDB_NAME=ao-test-pg
TESTDB_PORT="${TESTDB_PORT:-5433}"
TESTDB_URL="postgres://postgres:test@localhost:${TESTDB_PORT}/postgres?sslmode=disable"

testdb() {
  case "${1:-up}" in
    up)
      if ! docker ps --format '{{.Names}}' | grep -qx "$TESTDB_NAME"; then
        docker rm -f "$TESTDB_NAME" >/dev/null 2>&1 || true
        docker run -d --name "$TESTDB_NAME" --restart unless-stopped \
          -e POSTGRES_PASSWORD=test -p "${TESTDB_PORT}:5432" \
          pgvector/pgvector:pg16 >/dev/null
        printf 'waiting for %s' "$TESTDB_NAME"
        until docker exec "$TESTDB_NAME" pg_isready -U postgres >/dev/null 2>&1; do
          printf '.'; sleep 1
        done
        echo
      fi
      echo "$TESTDB_URL"
      ;;
    down) docker rm -f "$TESTDB_NAME" >/dev/null 2>&1 && echo "removed $TESTDB_NAME" || echo "not running" ;;
    *) echo "usage: ./stack testdb [up|down]" >&2; exit 1 ;;
  esac
}

# Run the Go suite the way that actually proves something. -p 1 is required:
# parallel packages against one throwaway Postgres produce false failures and
# leak a connection pool per test.
test_go() {
  testdb up >/dev/null
  ( cd go && AGENTKIT_TEST_POSTGRES_URL="$TESTDB_URL" go test -p 1 -count=1 "$@" ./... )
}

help() {
  sed -n '3,26p' "$0" | sed 's/^# \{0,1\}//'
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
cmd="${1:-help}"
shift || true
case "$cmd" in
  build|start|stop|restart|logs|psql|sql|status|sessions|clean|testdb|help) "$cmd" "$@" ;;
  publish-base|publish_base) publish_base "$@" ;;
  test-go|test_go) test_go "$@" ;;
  db) psql "$@" ;;
  *) echo "unknown command: $cmd" >&2; help; exit 1 ;;
esac
