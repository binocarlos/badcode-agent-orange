# Generated by run.sh from the committed manifests, deterministically — and
# refused by truths.ts if stale, so there is nothing to gain by tracking it.
datasets/

# The raw event + config logs per arm. Ids and timestamps, megabytes of them,
# and NOT the report: this is what gets copied into docs/product/runs/ after a
# live run, not what accumulates from smoke runs. (`*.run-metadata.json` is
# already covered by ../.gitignore.)
*.run-log.json
